+    // sync. Messages: {bbl3d: 1, type: "open", name, bytes, index} and
+    // {bbl3d: 1, type: "seek", time} (µs, log clock) in; "loaded" and
+    // {type: "time", time} out.
+    if (globalThis.parent !== globalThis) {
+      const post = (msg) => globalThis.parent.postMessage({ bbl3d: 1, ...msg }, globalThis.location.origin);
+      let pendingIndex = null;
+      let seenLog = null;
+      let lastTime = null;
+      globalThis.addEventListener("message", (e) => {
+        if (e.source !== globalThis.parent || e.origin !== globalThis.location.origin || e.data?.bbl3d !== 1) return;
+        const m = e.data;
+        if (m.type === "open") {
+          pendingIndex = m.index ?? null;
+          loadFiles([new File([m.bytes], m.name)]);
+        } else if (m.type === "seek" && logStore.hasLog && Number.isFinite(m.time)) {
+          lastTime = m.time;
+          setCurrentBlackboxTime(m.time);
+        } else if (m.type === "resize") {
+          globalThis.dispatchEvent(new Event("resize"));
+        }
+      });
+      const tick = () => {
+        if (logStore.hasLog && logStore.flightLog !== seenLog) {
+          seenLog = logStore.flightLog;
+          if (pendingIndex !== null && pendingIndex !== playbackStore.currentOffsetCache.index) selectLog(pendingIndex);
+          pendingIndex = null;
+          // the start position is ours to set; don't report it back
+          lastTime = logStore.currentBlackboxTime;
+          post({ type: "loaded" });
+        }
+        const t = logStore.currentBlackboxTime;
+        if (logStore.hasLog && t !== lastTime) {
+          lastTime = t;
+          post({ type: "time", time: t });
+        }
+        requestAnimationFrame(tick);
+      };
+      requestAnimationFrame(tick);
+    }
+
